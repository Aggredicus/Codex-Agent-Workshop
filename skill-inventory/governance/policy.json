        "agent"
      ]
    },
    "contributor": {
      "allowed": [
        "skill.discover",
        "pr.propose"
      ],
      "skill_scopes": [
        "*"
      ],
      "actor_kinds": [
        "human",
        "agent"
      ]
    },
    "developer": {
      "allowed": [
        "skill.discover",
        "skill.execute",
        "pr.propose"
      ],
      "skill_scopes": [
        "*"
      ],
      "actor_kinds": [
        "human",
        "agent"
      ]
    },
    "reviewer": {
      "allowed": [
        "skill.discover",
        "skill.execute",
        "pr.propose",
        "pr.review"
      ],
      "skill_scopes": [
        "*"
      ],
      "actor_kinds": [
        "human"
      ]
    },
    "maintainer": {
      "allowed": [
        "skill.discover",
        "skill.execute",
        "pr.propose",
        "pr.review",
        "pr.merge",
        "policy.vote"
      ],
      "skill_scopes": [
