        "pr.propose"
      ],
      "skill_scopes": [
        "*"
      ],
      "actor_kinds": [
        "agent"
      ]
    }
  },
  "capability_overrides": {
    "authorization": {
      "human_approval_for": [
        "skill.execute",
        "pr.review",
        "pr.merge"
      ]
    },
    "authentication": {
      "human_approval_for": [
        "skill.execute",
        "pr.review",
        "pr.merge"
      ]
    },
    "secrets-management": {
      "human_approval_for": [
        "skill.execute",
        "pr.review",
        "pr.merge"
      ]
    },
    "deployment": {
      "human_approval_for": [
        "skill.execute",
        "pr.merge"
      ]
    },
    "privacy-engineering": {
      "human_approval_for": [
        "skill.execute",
        "pr.merge"
      ]
    }
  },
  "voting": {
    "purpose": "Approve proposed changes to role/skill policy, with auditable authenticated GitHub PR reviews",
    "min_independent_human_approvals": 1,
    "agent_votes_count": false,
    "author_vote_counts": false,
    "mechanism": "required-reviewer-and-protected-branch",
    "fallback": "deny"
  },
  "non_enforcement_notice": "This public file is proposed policy documentation. Effective actor authorization must be verified by trusted GitHub identity, rulesets/CODEOWNERS and scoped credentials. A locally supplied --role is untrusted and can never grant repository write/merge rights."
}
